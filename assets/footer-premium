/* =========================================================
   CHATPHETCH GROUP
   PREMIUM FOOTER — STYLE BASED ON REFERENCE #2
   ========================================================= */

.customer-footer {
  position: relative;
  width: 100%;
  background:
    radial-gradient(
      circle at 18% 20%,
      rgba(82, 61, 30, 0.10),
      transparent 34%
    ),
    linear-gradient(
      180deg,
      #0a0907 0%,
      #050504 100%
    );
  color: #8f8982;
  border-top: 1px solid rgba(198,160,106,.18);
}

/* =========================================================
   MAIN FOOTER CONTAINER
   ========================================================= */

.customer-footer-inner {
  width: min(
    calc(100% - 80px),
    1600px
  );

  margin-inline: auto;

  padding:
    78px 0 26px;
}

/* =========================================================
   UPPER AREA
   ========================================================= */

.customer-footer-upper {
  display: grid;

  grid-template-columns:
    minmax(0, 1fr)
    360px;

  gap: 120px;

  min-height: 390px;

  align-items: start;
}

/* =========================================================
   BRAND AREA
   ========================================================= */

.customer-footer-brand-area {
  padding-top: 0;
}

.customer-footer-brand {
  display: flex;
  align-items: center;

  gap: 24px;
}

.customer-footer-logo {
  width: 92px;
  height: 92px;

  object-fit: contain;

  flex: 0 0 auto;
}

.customer-footer-brand-copy {
  display: flex;
  flex-direction: column;
}

.customer-footer-brand-name {
  color: #f7f3ed;

  font-size: 31px;
  line-height: 1.05;

  font-weight: 700;

  letter-spacing: -.035em;
}

.customer-footer-brand-sub {
  margin-top: 11px;

  color: #d5b56e;

  font-size: 14px;

  font-weight: 500;

  letter-spacing: .22em;

  text-transform: uppercase;
}

/* =========================================================
   COMPANY INFORMATION
   ========================================================= */

.customer-footer-info {
  margin-top: 48px;
}

.customer-footer-company-line {
  color: #918b85;

  font-size: 16px;

  line-height: 1.8;
}

.customer-footer-company-line.strong {
  color: #a59e97;

  font-size: 15px;
}

.customer-footer-company-line + .customer-footer-company-line {
  margin-top: 20px;
}

.customer-footer-company-line .flower {
  margin-right: 12px;
}

/* =========================================================
   SERVICE HIGHLIGHTS
   ========================================================= */

.customer-footer-service-line {
  display: flex;

  flex-wrap: wrap;

  align-items: center;

  gap: 34px;

  color: #928b85;

  font-size: 15px;

  line-height: 1.7;
}

.customer-footer-service-item {
  display: inline-flex;

  align-items: center;

  gap: 10px;
}

.customer-footer-service-item .icon {
  color: #7770ae;

  font-size: 20px;
}

/* =========================================================
   MENU
   ========================================================= */

.customer-footer-menu {
  padding-top: 0;
}

.customer-footer-menu-title {
  display: inline-block;

  position: relative;

  padding-bottom: 15px;

  color: #e2c476;

  font-size: 19px;

  font-weight: 600;

  letter-spacing: .07em;

  text-transform: uppercase;
}

.customer-footer-menu-title::after {
  content: "";

  position: absolute;

  left: 0;
  bottom: 0;

  width: 53px;
  height: 2px;

  background: #d0aa61;
}

.customer-footer-menu-list {
  display: flex;

  flex-direction: column;

  align-items: flex-start;

  gap: 17px;

  margin: 29px 0 0;

  padding: 0;

  list-style: none;
}

.customer-footer-menu-list li {
  margin: 0;
  padding: 0;
}

.customer-footer-menu-list a {
  display: inline-block;

  color: #807a74;

  font-size: 16px;

  line-height: 1.5;

  text-decoration: none;

  transition:
    color .22s ease,
    transform .22s ease;
}

.customer-footer-menu-list a:hover {
  color: #e1c37b;

  transform: translateX(4px);
}

/* =========================================================
   DIVIDER
   ========================================================= */

.customer-footer-divider {
  width: 100%;

  height: 1px;

  margin:
    0 0 28px;

  background:
    rgba(198,160,106,.38);
}

/* =========================================================
   BOTTOM BAR
   ========================================================= */

.customer-footer-bottom {
  display: grid;

  grid-template-columns:
    minmax(280px, 1.1fr)
    minmax(300px, 1fr)
    auto
    auto;

  align-items: center;

  column-gap: 34px;
}

/* =========================================================
   COPYRIGHT
   ========================================================= */

.customer-footer-copyright {
  color: #77716b;

  font-size: 13px;

  line-height: 1.6;

  white-space: nowrap;
}

.customer-footer-copyright strong {
  color: #d0cbc4;

  font-weight: 600;
}

/* =========================================================
   ADDRESS
   ========================================================= */

.customer-footer-address {
  display: flex;

  align-items: center;

  gap: 11px;

  min-width: 0;

  color: #88817a;

  font-size: 13px;

  white-space: nowrap;
}

.customer-footer-address-icon {
  flex: 0 0 auto;

  color: #f05b82;

  font-size: 18px;
}

/* =========================================================
   ACTION BUTTONS
   ========================================================= */

.customer-footer-actions {
  display: flex;

  align-items: center;

  gap: 14px;

  padding-left: 30px;

  border-left:
    1px solid
    rgba(198,160,106,.18);
}

.customer-footer-action {
  display: inline-flex;

  align-items: center;

  justify-content: center;

  gap: 8px;

  min-height: 44px;

  padding:
    0 21px;

  border:
    1px solid
    rgba(198,160,106,.34);

  border-radius: 13px;

  color: #dfc477;

  background:
    rgba(18,14,10,.55);

  font-size: 13px;

  white-space: nowrap;

  text-decoration: none;

  transition:
    color .22s ease,
    background .22s ease,
    border-color .22s ease,
    transform .22s ease;
}

.customer-footer-action:hover {
  color: #fff4d8;

  background:
    rgba(198,160,106,.10);

  border-color:
    #c6a06a;

  transform:
    translateY(-1px);
}

.customer-footer-action-icon {
  font-size: 15px;
}

/* =========================================================
   SOCIAL
   ========================================================= */

.customer-footer-social {
  display: flex;

  align-items: center;

  gap: 12px;

  padding-left: 28px;

  border-left:
    1px solid
    rgba(198,160,106,.18);
}

.customer-social {
  display: inline-flex;

  align-items: center;

  justify-content: center;

  width: 58px;
  height: 58px;

  border:
    1px solid
    rgba(198,160,106,.38);

  border-radius: 50%;

  color: #dfc477;

  background:
    rgba(15,11,8,.45);

  font-size: 18px;

  text-decoration: none;

  transition:
    color .22s ease,
    background .22s ease,
    border-color .22s ease,
    transform .22s ease;
}

.customer-social:hover {
  color: #fff4d8;

  background:
    rgba(198,160,106,.10);

  border-color:
    #c6a06a;

  transform:
    translateY(-2px);
}

.customer-social.youtube {
  font-size: 17px;
}

.customer-social.line {
  font-size: 14px;

  font-weight: 500;

  letter-spacing: -.02em;
}

/* =========================================================
   FLOATING PHONE
   ========================================================= */

.customer-floating-phone {
  position: fixed;

  right: 26px;
  bottom: 92px;

  z-index: 8800;

  display: inline-flex;

  align-items: center;

  justify-content: center;

  width: 58px;
  height: 58px;

  border:
    1px solid
    rgba(198,160,106,.48);

  border-radius: 50%;

  color: #e4c77c;

  background:
    rgba(10,8,6,.95);

  box-shadow:
    0 12px 35px
    rgba(0,0,0,.38);

  backdrop-filter:
    blur(10px);

  font-size: 20px;

  text-decoration: none;

  transition:
    transform .22s ease,
    border-color .22s ease,
    background .22s ease;
}

.customer-floating-phone:hover {
  transform:
    translateY(-3px);

  border-color:
    #d4b26b;

  background:
    rgba(198,160,106,.10);
}

/* =========================================================
   TABLET
   ========================================================= */

@media (max-width: 1200px) {

  .customer-footer-inner {
    width:
      calc(100% - 56px);

    padding:
      64px 0 24px;
  }

  .customer-footer-upper {
    grid-template-columns:
      minmax(0, 1fr)
      300px;

    gap: 70px;

    min-height: 350px;
  }

  .customer-footer-brand-name {
    font-size: 28px;
  }

  .customer-footer-bottom {
    grid-template-columns:
      1fr
      1fr;

    row-gap: 22px;
  }

  .customer-footer-actions {
    justify-self: end;
  }

  .customer-footer-social {
    justify-self: end;
  }
}

/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 700px) {

  .customer-footer-inner {
    width:
      calc(100% - 36px);

    padding:
      48px 0 22px;
  }

  .customer-footer-upper {
    display: flex;

    flex-direction: column;

    gap: 48px;

    min-height: 0;
  }

  .customer-footer-brand {
    gap: 16px;
  }

  .customer-footer-logo {
    width: 72px;
    height: 72px;
  }

  .customer-footer-brand-name {
    font-size: 23px;
  }

  .customer-footer-brand-sub {
    margin-top: 8px;

    font-size: 10px;

    letter-spacing: .16em;
  }

  .customer-footer-info {
    margin-top: 32px;
  }

  .customer-footer-company-line {
    font-size: 14px;
  }

  .customer-footer-company-line.strong {
    font-size: 13px;
  }

  .customer-footer-service-line {
    gap: 15px 22px;

    font-size: 13px;
  }

  .customer-footer-menu-title {
    font-size: 17px;
  }

  .customer-footer-menu-list {
    gap: 14px;

    margin-top: 24px;
  }

  .customer-footer-menu-list a {
    font-size: 14px;
  }

  .customer-footer-divider {
    margin:
      38px 0 22px;
  }

  .customer-footer-bottom {
    display: flex;

    flex-direction: column;

    align-items: stretch;

    gap: 18px;
  }

  .customer-footer-copyright {
    white-space: normal;

    font-size: 12px;
  }

  .customer-footer-address {
    white-space: normal;

    font-size: 12px;
  }

  .customer-footer-actions {
    padding-left: 0;

    border-left: 0;

    justify-content: flex-start;

    flex-wrap: wrap;
  }

  .customer-footer-action {
    min-height: 42px;

    padding:
      0 17px;

    font-size: 12px;
  }

  .customer-footer-social {
    padding-left: 0;

    border-left: 0;

    justify-content: flex-start;
  }

  .customer-social {
    width: 48px;
    height: 48px;
  }

  .customer-floating-phone {
    right: 18px;
    bottom: 22px;

    width: 52px;
    height: 52px;

    font-size: 18px;
  }
}

/* =========================================================
   SMALL MOBILE
   ========================================================= */

@media (max-width: 480px) {

  .customer-footer-inner {
    width:
      calc(100% - 28px);

    padding:
      40px 0 18px;
  }

  .customer-footer-brand {
    align-items: flex-start;
  }

  .customer-footer-logo {
    width: 62px;
    height: 62px;
  }

  .customer-footer-brand-name {
    font-size: 20px;
  }

  .customer-footer-brand-sub {
    font-size: 9px;

    letter-spacing: .12em;
  }

  .customer-footer-company-line {
    font-size: 13px;
  }

  .customer-footer-service-line {
    display: grid;

    grid-template-columns:
      1fr 1fr;

    gap: 13px;
  }

  .customer-footer-service-item {
    font-size: 12px;
  }

  .customer-footer-action {
    width: 100%;
  }

  .customer-footer-social {
    gap: 9px;
  }

  .customer-social {
    width: 45px;
    height: 45px;
  }

  .customer-floating-phone {
    width: 50px;
    height: 50px;
  }
}
